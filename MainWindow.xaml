<Window x:Class="BananaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banana Clicker" Height="700" Width="1000"
        FontFamily="Segoe UI" Background="#2E7D32">

    <Window.Resources>
        <ControlTemplate x:Key="EmptyBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <DrawingBrush x:Key="LeafBG" TileMode="Tile" Viewport="0,0,220,220" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#2E7D32">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,220,220"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#388E3C">
                            <GeometryDrawing.Geometry><PathGeometry Figures="M0,30 Q15,0 30,30 Q15,45 0,30 Z"/></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <DrawingGroup.Transform><TranslateTransform X="10" Y="10"/></DrawingGroup.Transform>
                    </DrawingGroup>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#1B5E20">
                            <GeometryDrawing.Geometry><PathGeometry Figures="M0,30 Q15,0 30,30 Q15,45 0,30 Z"/></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <DrawingGroup.Transform>
                            <TransformGroup><RotateTransform Angle="120"/><TranslateTransform X="150" Y="40"/></TransformGroup>
                        </DrawingGroup.Transform>
                    </DrawingGroup>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#43A047">
                            <GeometryDrawing.Geometry><PathGeometry Figures="M0,30 Q15,0 30,30 Q15,45 0,30 Z"/></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <DrawingGroup.Transform>
                            <TransformGroup><RotateTransform Angle="45"/><TranslateTransform X="60" Y="140"/></TransformGroup>
                        </DrawingGroup.Transform>
                    </DrawingGroup>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#1B5E20">
                            <GeometryDrawing.Geometry><PathGeometry Figures="M0,30 Q15,0 30,30 Q15,45 0,30 Z"/></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <DrawingGroup.Transform>
                            <TransformGroup><RotateTransform Angle="200"/><TranslateTransform X="180" Y="170"/></TransformGroup>
                        </DrawingGroup.Transform>
                    </DrawingGroup>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#388E3C">
                            <GeometryDrawing.Geometry><PathGeometry Figures="M0,30 Q15,0 30,30 Q15,45 0,30 Z"/></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <DrawingGroup.Transform>
                            <TransformGroup><RotateTransform Angle="300"/><TranslateTransform X="10" Y="190"/></TransformGroup>
                        </DrawingGroup.Transform>
                    </DrawingGroup>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="#7B4B22"/>
            <Setter Property="Foreground" Value="#FFE0B2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#9A622F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===== Игровой экран ===== -->
        <Grid x:Name="GamePage" Background="{StaticResource LeafBG}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="BananasText" Grid.Row="0" Text="0"
                       FontSize="64" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,30,0,0">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2"/></TextBlock.Effect>
            </TextBlock>

            <Button x:Name="BonusBtn" Grid.Row="0" Content="⏳ Бонус ×2"
                    HorizontalAlignment="Left" Margin="25,30,0,0" Padding="15,8"
                    Background="#E8842C" Foreground="White" FontWeight="Bold" FontSize="16"
                    BorderThickness="0" Cursor="Hand" Click="Bonus_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- НОВАЯ КНОПКА: открытие магазина -->
            <Button x:Name="ShopBtn" Grid.Row="0" Content="🎒 Магазин"
                    HorizontalAlignment="Right" Margin="0,30,25,0" Padding="15,8"
                    Background="#7B4B22" Foreground="White" FontWeight="Bold" FontSize="16"
                    BorderThickness="0" Cursor="Hand" Click="Shop_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Row="1" x:Name="BananaBtn" Width="320" Height="260"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    PreviewMouseLeftButtonDown="Banana_Click"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Статистика: обновляется из кода, без биндингов -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🍌 +" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="ClickText" Text="1" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text=" за клик" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="⚡ " Foreground="#C8E6C9" FontSize="16"/>
                    <TextBlock x:Name="CpsText" Text="0" Foreground="#C8E6C9" FontSize="16"/>
                    <TextBlock Text=" / сек" Foreground="#C8E6C9" FontSize="16"/>
                </StackPanel>
            </StackPanel>

            <Canvas x:Name="FloatLayer" Grid.RowSpan="3" IsHitTestVisible="False"/>
        </Grid>

        <!-- ===== Магазин ===== -->
        <Grid x:Name="ShopPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="3" Background="#3E2723" Opacity="0.97"/>

            <Grid Grid.Row="0" Margin="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="TabInventory" Content="🎒 Inventory" Style="{StaticResource TabBtn}" Margin="5,0" Click="TabInventory_Click"/>
                    <Button x:Name="TabExchange" Content="🔄 Exchange" Style="{StaticResource TabBtn}" Margin="5,0" Click="TabExchange_Click"/>
                    <Button x:Name="TabStack" Content="📊 Stack" Style="{StaticResource TabBtn}" Margin="5,0" Click="TabStack_Click"/>
                </StackPanel>
                <TextBlock x:Name="ShopBananasText" Text="0"
                           Foreground="#FFDE03" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Button Content="🏠" FontSize="22" Width="48" Height="48"
                        HorizontalAlignment="Left" Background="#7B4B22" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="Home_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0">
                <ContentControl x:Name="ShopContent"/>
            </ScrollViewer>

            <StackPanel x:Name="PagerPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
                <Button x:Name="PrevBtn" Content="◀" Width="50" Height="40" Margin="8,0"
                        Background="#E8842C" Foreground="White" FontSize="18" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="Prev_Click"/>
                <TextBlock x:Name="PageLabel" Text="Page 1 of 1" Foreground="#FFE0B2"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0"/>
                <Button x:Name="NextBtn" Content="▶" Width="50" Height="40" Margin="8,0"
                        Background="#E8842C" Foreground="White" FontSize="18" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>